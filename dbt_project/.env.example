# Copy this file to .env (gitignored) and fill in the values.
# Usage:  cd dbt_project && source .env && dbt debug --target <name>

# Tell dbt to look for profiles.yml in this directory (next to dbt_project.yml).
export DBT_PROFILES_DIR='.'

# --- BigQuery (target: dev) ---
# Absolute path to a GCP service-account JSON keyfile with BigQuery Data Editor + Job User roles.
export GCP_KEYFILE_PATH=''
export GCP_PROJECT_ID=''
# Optional overrides (defaults: dataset=analytics, location=US)
# export GCP_DATASET='analytics'
# export GCP_LOCATION='US'

# --- Snowflake (target: snowflake_prod) ---
# Account identifier: <orgname>-<account_name> (preferred) or <locator>.<region> (legacy).
# Find it in Snowsight: bottom-left user menu → Account → copy the identifier from the URL.
export SNOWFLAKE_ACCOUNT=''
export SNOWFLAKE_USER='DBT_USER'
export SNOWFLAKE_PASSWORD=''
# Optional overrides (defaults match scripts/snowflake_setup.sql)
# export SNOWFLAKE_ROLE='TRANSFORMER'
# export SNOWFLAKE_DATABASE='ANALYTICS'
# export SNOWFLAKE_WAREHOUSE='TRANSFORMING_WH'
# export SNOWFLAKE_SCHEMA='STAGING'
